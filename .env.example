# Copy to .env and fill in real values. Never commit .env.

# --- Neon Postgres (shared by insight-hub-web and insight-hub-pipeline) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- insight-hub-pipeline (Python) ---
# Anthropic SDK: theme detection, executive summary
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini API (aistudio.google.com, free tier): sentiment reclassification.
# Provisoire — remplace Anthropic pour ce module précis pour éviter les coûts API
# le temps du développement ; voir openspec/changes pour le contexte de cette décision.
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model used for sentiment reclassification (optional, defaults to gemini-flash-lite-latest).
# gemini-2.5-flash-lite (pinned version) returns 404 for API keys created after
# its cutoff — confirmed against a real key — use the "-latest" alias instead.
# Bump to a more capable model if the validation sample's agreement rate stays under 80%.
GEMINI_SENTIMENT_MODEL=gemini-flash-lite-latest

# --- Inter-service auth (shared secret, set identically on both Vercel projects) ---
# Bearer token insight-hub-web sends when calling insight-hub-pipeline
PIPELINE_AUTH_TOKEN=change-me-to-a-random-secret

# --- insight-hub-web (Next.js) ---
# Base URL of the insight-hub-pipeline service
PIPELINE_SERVICE_URL=https://insight-hub-pipeline.vercel.app

# Vercel Blob: used when the uploaded CSV exceeds 4.5 MB (default function payload limit)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
